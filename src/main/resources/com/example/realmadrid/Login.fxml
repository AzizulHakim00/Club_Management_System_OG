      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="38.0" prefWidth="47.0">
         <children>
            <ImageView fitHeight="38.0" fitWidth="47.0" layoutX="3.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
