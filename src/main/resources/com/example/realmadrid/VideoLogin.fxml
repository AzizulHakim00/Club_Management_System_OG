<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="462.0" prefWidth="799.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.realmadrid.Controller.LoginController">

    <MediaView fx:id="mediaView" fitHeight="539.0" fitWidth="825.0" layoutX="-7.0" AnchorPane.bottomAnchor="-55.0"
               AnchorPane.leftAnchor="-7.0" AnchorPane.rightAnchor="-19.0" AnchorPane.topAnchor="0.0"/>

    <Pane layoutX="254.0" layoutY="84.0" prefHeight="352.0" prefWidth="291.0"
          style="-fx-background-color: #ffffff67; -fx-background-radius: 10px;">
        <effect>
            <DropShadow color="#404040"/>
        </effect>

        <TextField fx:id="usernameField" layoutX="49.0" layoutY="202.0" prefHeight="29.0" prefWidth="202.0"
                   promptText="USERNAME"
                   style="-fx-border-radius: 5px; -fx-border-color: #fff; -fx-background-radius: 5px; -fx-padding: 10;">
        </TextField>

        <PasswordField fx:id="passwordField" layoutX="49.0" layoutY="246.0" prefHeight="15.0" prefWidth="202.0"
                       promptText="PASSWORD"
                       style="-fx-border-radius: 5px; -fx-border-color: #fff; -fx-background-radius: 5px; -fx-padding: 10;">
        </PasswordField>

        <Button fx:id="signinButton" layoutX="49.0" layoutY="280.0" prefHeight="43.0" prefWidth="202.0"
                style="-fx-background-color: 151740; -fx-background-radius: 50px;" text="SIGNIN" textFill="WHITE"/>

        <Button fx:id="forgotPasswordButton" layoutX="47.0" layoutY="316.0" prefHeight="43.0" prefWidth="202.0"
                style="-fx-background-radius: 50px; -fx-background-color: 004080; -fx-underline: true;"
                text="FORGOT PASSWORD" textFill="WHITE"/>

        <Label layoutX="79.0" layoutY="62.0" text="YOUR LOGO" textFill="WHITE">
            <font>
                <Font size="25.0"/>
            </font>
        </Label>
    </Pane>
</AnchorPane>
