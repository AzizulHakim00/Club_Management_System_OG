<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.realmadrid.Controller.PlayerEditDialogController"
      spacing="10" alignment="CENTER" style="-fx-background-color: #f9f9f9;"
      padding="20">

    <Label text="Edit Player" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Position:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="positionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Image Path:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="imagePathField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="okButton" text="OK" onAction="#handleOk"/>
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"/>
    </HBox>
</VBox>
